---
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: CollectionEntry<'blog'>;
	prev?: { title: string; url: string } | null;
	next?: { title: string; url: string } | null;
}

const { post, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, categories, tags } = post.data;
---

<BaseLayout title={title} description={description} type="article">
	<div class="mx-auto max-w-3xl">
		<article class="mb-20">
			<div class="prose dark:prose-invert mx-auto prose-slate prose-a:text-primary-500 max-w-none">
				<header class="flex flex-col gap-y-3 not-prose mb-8 pb-6 border-b border-slate-200 dark:border-slate-700">
					<h1 class="text-balance text-3xl sm:text-4xl font-headings">{title}</h1>
					<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-slate-500 dark:text-slate-400">
						<FormattedDate date={pubDate} />
						{updatedDate && (
							<span>· Updated: <FormattedDate date={updatedDate} /></span>
						)}
						{categories && categories.length > 0 && (
							<span>
								·&nbsp;
								{categories.map((cat: string, i: number) => (
									<>
										{i > 0 && ', '}
										<a href={`/categories/${cat}/`} class="hover:text-primary-500 transition">{cat}</a>
									</>
								))}
							</span>
						)}
					</div>
				</header>
				<slot />
			</div>

			{tags && tags.length > 0 && (
				<div class="mt-8 pt-6 border-t border-slate-200 dark:border-slate-700 flex flex-wrap gap-2">
					{tags.map((tag: string) => (
						<a
							href={`/tags/${tag}/`}
							class="inline-block px-3 py-1 text-sm bg-slate-100 dark:bg-slate-800 rounded-full hover:bg-primary-100 dark:hover:bg-primary-900 hover:text-primary-700 dark:hover:text-primary-300 transition"
						>
							#{tag}
						</a>
					))}
				</div>
			)}

			{(prev || next) && (
				<nav class="mt-10 pt-8 border-t border-slate-200 dark:border-slate-700 grid grid-cols-2 gap-4">
					{prev ? (
						<a
							href={prev.url}
							class="group flex flex-col gap-1 p-4 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-primary-50 dark:hover:bg-primary-950 transition"
						>
							<span class="text-xs text-slate-400 dark:text-slate-500">← Previous</span>
							<span class="text-sm font-medium line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition">{prev.title}</span>
						</a>
					) : <span />}
					{next ? (
						<a
							href={next.url}
							class="group flex flex-col gap-1 p-4 rounded-lg bg-slate-50 dark:bg-slate-800 hover:bg-primary-50 dark:hover:bg-primary-950 transition text-right"
						>
							<span class="text-xs text-slate-400 dark:text-slate-500">Next →</span>
							<span class="text-sm font-medium line-clamp-2 group-hover:text-primary-600 dark:group-hover:text-primary-400 transition">{next.title}</span>
						</a>
					) : <span />}
				</nav>
			)}
		</article>
	</div>
</BaseLayout>
