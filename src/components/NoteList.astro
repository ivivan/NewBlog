---
import type { CollectionEntry } from "astro:content";
import { formatDate, readingMinutes } from "../utils/reading";
import { categoryHref, categoryOf } from "../utils/research";

interface Props {
  notes: CollectionEntry<"research">[];
  /** Show each note's category (off on a category's own page). */
  showCategory?: boolean;
}
const { notes, showCategory = true } = Astro.props;
---

<ul class="divide-y divide-line border-t border-line">
  {
    notes.map((note) => (
      <li class="grid gap-2 py-6 sm:grid-cols-[128px_1fr] sm:gap-8">
        <span class="figure pt-1 text-[12px] text-ink-3">{formatDate(note.data.date)}</span>
        <div>
          <a href={`/research/${note.id}/`} class="group block">
            <span class="block font-bold text-[20px] leading-8 text-ink transition-colors duration-150 group-hover:text-accent">
              {note.data.title}
            </span>
            <span class="mt-1 block text-[14px] leading-6 text-ink-2">{note.data.description}</span>
          </a>
          <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-[12px] text-ink-3">
            {showCategory && (
              <a href={categoryHref(note.data.category)} class="text-accent transition-colors duration-150 hover:text-ink">
                {categoryOf(note.data.category).name}
              </a>
            )}
            <span class="figure">{readingMinutes(note.body)} 分钟</span>
            {note.data.tags.map((t) => (
              <a href={`/research/tag/${t}/`} class="figure transition-colors duration-150 hover:text-ink">#{t}</a>
            ))}
          </div>
        </div>
      </li>
    ))
  }
</ul>
