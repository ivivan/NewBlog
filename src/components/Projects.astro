---
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

const selectedProjectPosts = [
	{
		title: 'Github+Hexo+Domain静态博客',
		description: 'Static blog setup workflow with GitHub Pages, Hexo, and custom domain binding.',
	},
	{
		title: 'Openshift 搭建Ghost Blog平台及绑定域名',
		description: 'Notes on deploying Ghost on OpenShift, theme setup, and custom domain configuration.',
	},
	{
		title: 'VMWare Workstation use RedHat Enterprise6搭建Hadoop运行环境',
		description: 'Hands-on guide for building a Hadoop runtime environment on virtual machines.',
	},
	{
		title: 'Hadoop自定义Inputformat',
		description: 'Implementation notes for custom InputFormat in Hadoop data processing.',
	},
	{
		title: 'mesos安装总结',
		description: 'Installation summary and troubleshooting notes for Mesos setup.',
	},
	{
		title: 'nmon 工具使用',
		description: 'Performance monitoring workflow using nmon and nmon analyser.',
	},
];

const allPosts = (await getCollection('blog')).filter((post) => post.data.pubDate.getUTCFullYear() !== 1970);

function toLegacyUrl(post: (typeof allPosts)[0]) {
	const date = post.data.pubDate;
	const year = date.getFullYear();
	const month = String(date.getMonth() + 1).padStart(2, '0');
	const day = String(date.getDate()).padStart(2, '0');
	return `/${year}/${month}/${day}/${post.id}/`;
}

const projects = selectedProjectPosts
	.map((item) => {
		const post = allPosts.find((p) => p.data.title === item.title);
		if (!post) return null;
		return {
			title: item.title,
			description: item.description,
			domain: `${post.data.pubDate.getFullYear()} · Blog Archive`,
			href: toLegacyUrl(post),
		};
	})
	.filter(Boolean);
---

<div
	class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-14 gap-y-10 md:gap-y-18"
>
	{
		projects.map((project) => (
			<div class="flex flex-col space-y-5 text-sm relative group">
				<h2 class="font-semibold text-lg mb-2 ">
					<div class="absolute -inset-x-3 md:-inset-x-5 -inset-y-4 rounded-lg opacity-0 scale-75 group-hover:scale-100 group-hover:opacity-100 bg-slate-50 z-0 transition dark:bg-slate-800" />
					<a href={project!.href}>
						<span class="absolute -inset-x-3 md:-inset-x-5 -inset-y-4 rounded-lg z-10" />
						<span class="relative">{project!.title}</span>
					</a>
				</h2>
				<p class="relative leading-7 text-slate-700 dark:text-slate-300">
					{project!.description}
				</p>
				<p class="relative flex items-center space-x-1 text-slate-500 group-hover:text-primary-500">
					<span>{project!.domain}</span>
					<Icon name="heroicons:arrow-top-right-on-square" />
				</p>
			</div>
		))
	}
</div>
