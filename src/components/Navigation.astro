---
import { siteConfig } from "../config/content.ts";

const allLinks = [
  { href: "/", label: "首页" },
  { href: "/projects/", label: "项目" },
  { href: "/investing/", label: "投资" },
  { href: "/research/", label: "研究" },
  { href: "/about/", label: "关于" },
];
const links = allLinks.filter((l) => l.href !== "/investing/" || siteConfig.features.investing);

const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="border-b border-line">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href="/" class="text-[17px] font-bold text-ink">Hear The Wind Sing</a>

    <div class="flex items-center gap-1">
      <ul class="hidden items-center gap-1 md:flex">
        {
          links.map((l) => (
            <li>
              <a
                href={l.href}
                aria-current={isActive(l.href) ? "page" : undefined}
                class="rounded-md px-3 py-1.5 text-[14px] text-ink-2 transition-colors duration-150 hover:text-ink aria-[current=page]:text-ink aria-[current=page]:bg-raised"
              >
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>

      <button
        id="theme-toggle"
        type="button"
        class="ml-2 grid size-9 place-items-center rounded-md text-ink-3 transition-colors duration-150 hover:bg-raised hover:text-ink"
        aria-label="切换明暗主题"
      >
        <svg class="size-[18px] dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401" />
        </svg>
        <svg class="hidden size-[18px] dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
      </button>

      <button
        id="menu-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-md text-ink-3 transition-colors duration-150 hover:bg-raised hover:text-ink md:hidden"
        aria-label="打开菜单"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <svg class="size-[18px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </nav>

  <ul id="mobile-menu" class="hidden border-t border-line px-6 py-2 md:hidden">
    {
      links.map((l) => (
        <li>
          <a
            href={l.href}
            aria-current={isActive(l.href) ? "page" : undefined}
            class="block py-2.5 text-[15px] text-ink-2 aria-[current=page]:text-ink"
          >
            {l.label}
          </a>
        </li>
      ))
    }
  </ul>
</header>

<script>
  const themeToggle = document.getElementById("theme-toggle");
  themeToggle?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
    document.dispatchEvent(new CustomEvent("themechange"));
  });

  const menuToggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  menuToggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    menuToggle.setAttribute("aria-expanded", String(open));
  });
</script>
