---
import { siteConfig } from "../config/content.ts";

const year = new Date().getFullYear();

const links = [
  { href: "/rss.xml", label: "RSS" },
  { href: siteConfig.social.github, label: "GitHub", external: true },
  { href: siteConfig.social.instagram, label: "Instagram", external: true },
  { href: siteConfig.social.email, label: "邮件" },
];
---

<footer class="mt-24 border-t border-line">
  <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-[13px] text-ink-3 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-4">
      <span class="text-ink-2">© {year} {siteConfig.name}</span>
      {
        siteConfig.features.investing && (
          <a href="/investing/#disclosures" class="underline decoration-line-strong underline-offset-4 transition-colors duration-150 hover:text-ink">披露说明</a>
        )
      }
    </div>
    <ul class="flex items-center gap-4">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              class="transition-colors duration-150 hover:text-ink"
              {...(l.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</footer>
