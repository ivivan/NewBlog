---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatLegacyDate, getLegacyPosts, legacyHref, type LegacyPost } from "../../utils/legacy";

export function getStaticPaths() {
  const posts = getLegacyPosts(); // newest first
  return posts.map((post, i) => ({
    params: { slug: post.slug },
    props: { post, newer: posts[i - 1] ?? null, older: posts[i + 1] ?? null },
  }));
}

interface Props {
  post: LegacyPost;
  newer: LegacyPost | null;
  older: LegacyPost | null;
}
const { post, newer, older } = Astro.props;
---

<BaseLayout title={post.title} description={post.excerpt} noindex>
  <article class="mx-auto max-w-[44rem] px-6 pt-16">
    <a href="/drawer/" class="text-[13px] text-ink-3 transition-colors duration-150 hover:text-ink">← 风的抽屉</a>
    <h1 class="mt-6 text-[30px] leading-[1.3]">{post.title}</h1>
    <div class="figure mt-4 flex flex-wrap gap-x-4 gap-y-1 text-[12px] text-ink-3">
      <time datetime={formatLegacyDate(post.date)}>{formatLegacyDate(post.date)}</time>
      {post.categories.map((c) => <span>{c}</span>)}
    </div>
    <p class="mt-6 border-y border-line py-3 text-[13px] text-ink-3">
      写于 {post.year} 年的旧博客，文字保持原样；部分图片和链接已经失效。
    </p>

    <div class="prose legacy-post mt-8 max-w-none" set:html={post.html} />

    <nav class="mt-16 grid gap-4 border-t border-line pt-6 sm:grid-cols-2" aria-label="更多旧文章">
      {
        older ? (
          <a href={legacyHref(older.slug)} class="group block">
            <span class="text-[13px] text-ink-3">← 更早</span>
            <span class="mt-1 block text-[15px] leading-7 font-bold text-ink transition-colors duration-150 group-hover:text-accent">{older.title}</span>
          </a>
        ) : <span />
      }
      {
        newer && (
          <a href={legacyHref(newer.slug)} class="group block sm:text-right">
            <span class="text-[13px] text-ink-3">更晚 →</span>
            <span class="mt-1 block text-[15px] leading-7 font-bold text-ink transition-colors duration-150 group-hover:text-accent">{newer.title}</span>
          </a>
        )
      }
    </nav>
    <p class="mt-8 text-[13px] text-ink-3">
      <a href="/drawer/" class="underline decoration-line-strong underline-offset-4 hover:text-ink">回抽屉里再吹一篇</a>
    </p>
  </article>

  <script is:inline>
    // Images whose host is gone: show a quiet note instead of a broken icon
    (function () {
      function gone(img) {
        var note = document.createElement("span");
        note.className = "legacy-img-gone";
        note.textContent = "（图片已随风而去）";
        var link = img.parentElement && img.parentElement.tagName === "A" ? img.parentElement : img;
        link.replaceWith(note);
      }
      document.querySelectorAll("img[data-legacy-img]").forEach(function (img) {
        if (img.complete && img.naturalWidth === 0) gone(img);
        else img.addEventListener("error", function () { gone(img); });
      });
    })();
  </script>
</BaseLayout>
