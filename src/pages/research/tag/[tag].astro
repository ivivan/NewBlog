---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import NoteList from "../../../components/NoteList.astro";
import TagBar from "../../../components/TagBar.astro";
import { getNotes, tagCounts } from "../../../utils/research";

export async function getStaticPaths() {
  const notes = await getNotes();
  const tags = tagCounts(notes);
  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, tags, notes: notes.filter((n) => n.data.tags.includes(tag)) },
  }));
}

const { tag, tags, notes } = Astro.props;
---

<BaseLayout title={`#${tag} · 研究笔记`} description={`标签为 ${tag} 的研究笔记。`}>
  <section class="mx-auto max-w-4xl px-6 pt-20">
    <a href="/research/" class="text-[13px] text-ink-3 transition-colors duration-150 hover:text-ink">← 研究笔记</a>
    <h1 class="figure mt-4 text-[32px] leading-[1.15]">#{tag}</h1>
    <p class="mt-3 text-[13px] text-ink-3"><span class="figure">{notes.length}</span> 篇</p>
    <div class="mt-10"><TagBar tags={tags} active={tag} /></div>
    <div class="mt-6"><NoteList notes={notes} /></div>
  </section>
</BaseLayout>
