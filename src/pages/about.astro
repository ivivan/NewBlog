---
import BaseLayout from "../layouts/BaseLayout.astro";
import { aboutContent } from "../config/content.ts";
import { parseMarkdown } from "../utils/markdown";

const descriptionHtml = parseMarkdown(aboutContent.description);
---

<BaseLayout title={aboutContent.title} description={aboutContent.meta.description}>
  <section class="mx-auto max-w-4xl px-6 pt-20">
    <h1 class="text-[36px] leading-[1.15]">{aboutContent.title}</h1>
    <div class="mt-4 text-[20px] leading-8 text-ink-2 [&_p]:m-0" set:html={descriptionHtml} />

    <dl class="mt-12 divide-y divide-line border-y border-line">
      {
        aboutContent.skillGroups.map((group) => (
          <div class="grid gap-3 py-5 sm:grid-cols-[160px_1fr] sm:gap-8">
            <dt class="pt-1 text-[13px] text-ink-3">{group.label}</dt>
            <dd class="flex flex-wrap gap-2">
              {group.items.map((item) => (
                <span class="inline-flex h-7 items-center rounded-[4px] border border-line bg-card px-2.5 text-[13px] text-ink-2">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="mx-auto max-w-4xl px-6 pt-20">
    <h2 class="text-[24px]">{aboutContent.experience.title}</h2>
    <ol class="mt-8 grid gap-10 sm:grid-cols-3 sm:gap-8">
      {
        aboutContent.experience.items.map((item) => (
          <li class="border-t border-line-strong pt-5">
            <p class="figure text-[12px] text-ink-3">{item.period}</p>
            <h3 class="mt-3 text-[20px]">{item.position}</h3>
            <p class="mt-1 text-[14px] text-ink">{item.company}</p>
            <p class="mt-3 text-[14px] leading-6 text-ink-2">{item.description}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="mx-auto max-w-4xl px-6 pt-20">
    <div class="rounded-2xl border border-line bg-card p-8">
      <h2 class="text-[22px]">{aboutContent.connect.title}</h2>
      <p class="mt-3 text-[15px] leading-7 text-ink-2">{aboutContent.connect.description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={aboutContent.connect.email.href} class="inline-flex h-10 items-center rounded-lg bg-ink px-4 text-[14px] font-medium text-page transition-opacity duration-150 hover:opacity-90">写邮件</a>
      </div>
    </div>
  </section>
</BaseLayout>
